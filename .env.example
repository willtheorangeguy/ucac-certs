# Copy to .env for local development. On Fly these are set with `fly secrets set`.

# --- required ---------------------------------------------------------
# At least 32 characters. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma or newline separated. This allowlist is the entire security boundary:
# only these addresses can request a sign-in link.
MANAGER_EMAILS=manager@example.org

# --- email (Resend) ---------------------------------------------------
# Without a key, sign-in links are written to the log instead of emailed,
# which is fine locally and useless in production.
RESEND_API_KEY=
MAIL_FROM=certifications@example.org
# Must match the deployed origin, or sign-in links will point at the wrong host.
BASE_URL=http://127.0.0.1:8000

# --- storage and schedule --------------------------------------------
DATABASE_PATH=data/lss.sqlite3
# Uploaded copies of certificates. Defaults to an uploads/ directory beside the
# database, so one volume holds both and one backup catches both.
# UPLOADS_PATH=data/uploads
SCAN_HOUR=6
REMINDER_HOUR=7
